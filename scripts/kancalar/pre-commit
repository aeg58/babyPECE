#!/bin/sh
# pre-commit — korunan dala KOD kaydını reddeder.
#
# NEDEN VAR: korunan dala doğrudan yazılan kod, incelemeden geçmez ve geri alınması
# görev dalındakinden pahalıdır. Kural metin olarak tutmadı; makineye devredildi.
#
# HATAYA KAPALI DEĞİL, SESSİZ DE DEĞİL: korunan dal listesi yapılandırılmamışsa yaygın
# varsayılan adlar kullanılır ve bu durum EKRANA BASILIR. Sessizce korumasız kalınmaz.

set -u
KOK=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$KOK/scripts/ortak.sh" ] || { echo "pre-commit: scripts/ortak.sh yok — koruma YOK."; exit 0; }
. "$KOK/scripts/ortak.sh"

KORUNAN_DALLAR=""; ANA_DAL=""; KOD_DISI_YOLLAR="docs/ *.md LICENSE .gitignore ayarlar.conf"
# shellcheck disable=SC1091
[ -f "$KOK/ayarlar.conf" ] && . "$KOK/ayarlar.conf"

DAL=$(git branch --show-current 2>/dev/null) || exit 0
[ -n "$DAL" ] || exit 0

LISTE=$(korunan_dallar "$KORUNAN_DALLAR" "$ANA_DAL")
DALLAR=$(printf '%s' "$LISTE" | sed -n 1p)
KAYNAK=$(printf '%s' "$LISTE" | sed -n 2p)

KORUNAN=0
for d in $DALLAR; do [ "$DAL" = "$d" ] && KORUNAN=1; done
[ "$KORUNAN" = "1" ] || exit 0

KOD=""
for y in $(git diff --cached --name-only); do
  if kod_yolu_mu "$y" "$KOD_DISI_YOLLAR"; then KOD="$KOD $y"; fi
done
[ -n "$KOD" ] || exit 0

cat <<SON

  ✋ COMMIT DURDURULDU

  Korunan dal : $DAL
  Liste       : $DALLAR   (kaynak: $KAYNAK)
  Kod dosyası :$KOD

  Korunan dala doğrudan kod yazılmaz. Bir iş dalı aç, oraya işle, sonra birleştir.
  Bu commit gerçekten korunan dala aitse:  git commit --no-verify

SON
exit 1
